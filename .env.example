# ============================================================
# Equium Miner Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Solana RPC ---
# Helius, Triton, or any Solana mainnet RPC
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

# --- Wallet ---
# Solana private key in base58 or hex format
# WARNING: Never share this or commit it to git
PRIVATE_KEY=YOUR_BASE58_PRIVATE_KEY

# --- Mining Mode ---
# cpu = CPU only (default)
# gpu = CUDA GPU (requires NVIDIA GPU + CUDA toolkit)
MODE=cpu

# --- CPU Settings ---
# Number of mining threads (0 = auto: all cores minus 1)
THREADS=0

# --- GPU Settings ---
# GPU batch size in millions of nonces per kernel launch
# Each million uses ~37MB VRAM. Examples:
#   16 = ~592MB VRAM (safe for 4GB+ GPU)
#   32 = ~1.18GB VRAM (safe for 6GB+ GPU)
#   64 = ~2.37GB VRAM (safe for 8GB+ GPU)
#  128 = ~4.74GB VRAM (safe for 12GB+ GPU)
GPU_BATCH=16

# --- Advanced ---
# Max nonces to try per mining round (default: 1000000)
MAX_NONCES_PER_ROUND=1000000

# Max blocks to mine before exiting (0 = infinite)
MAX_BLOCKS=0

# Compute unit limit for Solana transaction (default: 1400000)
CU_LIMIT=1400000
