# Equium Miner Configuration
# Copy to .env and edit: cp .env.example .env

# Solana RPC endpoint (use Helius/Triton for production)
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Solana private key (base58, hex, or JSON array)
PRIVATE_KEY=

# Mining mode: "cpu" or "gpu"
MODE=cpu

# Number of solver threads (0 = all cores minus 1)
# Only used in CPU mode
THREADS=0

# GPU batch size (nonces per kernel launch, ~37MB VRAM each)
# Only used in GPU mode
GPU_BATCH=16

# Max nonce attempts per thread per round
MAX_NONCES_PER_ROUND=4096

# Stop after N successful blocks (0 = run forever)
MAX_BLOCKS=0

# Compute units per transaction
CU_LIMIT=1400000
